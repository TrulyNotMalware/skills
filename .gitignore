# External repositories cloned for reading; listed in README.md, never vendored
references/

# Claude Code / oh-my-claudecode runtime state (the .omc-workspace marker stays tracked)
.omc/
.claude/settings.local.json

# A copied third-party document kept for reference only
claude/

# Mods bound to the author's machine (personal wiki, ~/infra, Tailscale): kept local, never published
mods/wiki-guard/
mods/infra-pane/
mods/infra-preflight/

# Generated by the Claude Code plugin engine when a mod loads
mods/*/.claude-plugin/types/
mods/*/tsconfig.json

# Python
__pycache__/
*.pyc

# Names that must never appear in a published skill; read by scripts/check-skill.py
scripts/private-terms.txt

.DS_Store
